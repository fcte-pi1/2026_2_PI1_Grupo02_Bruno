@startuml
!pragma layout smetana
title Diagrama de pacotes da solução de software
left to right direction
skinparam packageStyle folder
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam package {
  BackgroundColor #F5F7FF
  BorderColor #4054A5
  FontColor #172554
}
skinparam ArrowColor #475569
skinparam ArrowFontColor #334155

package "Frontend React" as frontend {
  package "components" as components
  package "api" as api
  package "realtime" as realtime
  package "models" as models
}

package "Backend Spring Boot" as backend {
  package "config" as config
  package "controller" as controller
  package "dto" as dto
  package "service" as service
  package "model" as model
  package "repository" as repository
  package "adapter" as adapter {
    package "mqtt" as mqtt
    package "websocket" as websocket
    package "persistence" as persistence
  }
}

components ..> api
components ..> realtime
components ..> models
api ..> models
realtime ..> models

api ..> controller
api ..> dto
realtime ..> websocket
realtime ..> dto

controller ..> service
controller ..> dto
service ..> model
service ..> dto
service ..> repository
 mqtt ..> service
websocket ..> service
 persistence ..> repository
config ..> adapter
config ..> service

@enduml
